{
  "name": "rm-breeding-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../docs/openapi/openapi-auth.yaml -o src/app/core/api/generated/auth.d.ts && openapi-typescript ../docs/openapi/openapi-referential.yaml -o src/app/core/api/generated/referential.d.ts && openapi-typescript ../docs/openapi/openapi-domain.yaml -o src/app/core/api/generated/domain.d.ts && openapi-typescript ../docs/openapi/openapi-commercial.yaml -o src/app/core/api/generated/commercial.d.ts && openapi-typescript ../docs/openapi/openapi-pilotage.yaml -o src/app/core/api/generated/pilotage.d.ts",
    "serve:ssr:rm-breeding-web": "node dist/rm-breeding-web/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.3",
    "@primeuix/themes": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "express": "^5.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "primeng": "^22.1.4",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.0.8"
  }
}
